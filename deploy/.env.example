# Copie para deploy/.env (fora do Git) e troque a senha:
#   cp deploy/.env.example deploy/.env && sed -i "s/troque-esta-senha/$(openssl rand -hex 24)/" deploy/.env
# Use só letras e números na senha (ela entra numa string de conexão).
# Chaves da API (T-211), base64 de 32 bytes cada; gere com:
#   sed -i "s|^MMO_SESSION_KEY=.*|MMO_SESSION_KEY=$(openssl rand -base64 32)|; s|^MMO_GAME_TICKET_KEY=.*|MMO_GAME_TICKET_KEY=$(openssl rand -base64 32)|" deploy/.env
# A de sessão só a API usa. A de token de jogo é a mesma na API e no servidor de jogo (T-212).

POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_USER=mmo
POSTGRES_DB=mmo

MMO_SESSION_KEY=troque-esta-chave
MMO_GAME_TICKET_KEY=troque-esta-chave

# API (opcionais; padrões no compose.yml)
# MMO_GAME_SERVER_ID=game.dev            # servidor para o qual os tokens de jogo valem
# MMO_GAME_SERVER_ADDRESS=host:7777      # endereço devolvido ao cliente em /characters/{id}/play
# MMO_AUTH_RATE_LIMIT=10                 # cadastros e logins por IP por minuto

# Servidor de jogo (opcionais; padrões no compose.yml)
# GAME_ENCOUNTER=encounter.forest_matriarch
# GAME_BOTS=true
# GAME_RESTART_AFTER=10
# GAME_LOG_LEVEL=info
