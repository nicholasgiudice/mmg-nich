{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "game-data.schema.json",
  "title": "Dados de jogo (data/*.json)",
  "description": "Apenas para autocomplete no editor. A validação oficial é a do Game.Data (C#). Tempos em segundos.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "classes": { "type": "array", "items": { "$ref": "#/$defs/class" } },
    "abilities": { "type": "array", "items": { "$ref": "#/$defs/ability" } },
    "statuses": { "type": "array", "items": { "$ref": "#/$defs/status" } },
    "areas": { "type": "array", "items": { "$ref": "#/$defs/area" } },
    "monsters": { "type": "array", "items": { "$ref": "#/$defs/monster" } },
    "arenas": { "type": "array", "items": { "$ref": "#/$defs/arena" } },
    "encounters": { "type": "array", "items": { "$ref": "#/$defs/encounter" } },
    "rules": {
      "type": "object",
      "description": "Regras globais; uma seção por assunto (control, threat...).",
      "properties": {
        "control": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "durationByRank": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "normal": { "type": "number", "minimum": 0 },
                "elite": { "type": "number", "minimum": 0 },
                "boss": { "type": "number", "minimum": 0 }
              }
            },
            "diminishing": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "window": { "$ref": "#/$defs/seconds" },
                "steps": { "type": "array", "minItems": 1, "items": { "type": "number", "minimum": 0, "maximum": 1 } }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$",
      "description": "snake_case com namespace por ponto, ex.: monster.grey_wolf"
    },
    "seconds": { "type": "number", "minimum": 0 },
    "school": { "enum": ["physical", "arcane", "fire", "frost", "holy", "nature"] },
    "faction": { "enum": ["enemy", "ally", "any"] },
    "idList": { "type": "array", "items": { "$ref": "#/$defs/id" } },
    "stringList": { "type": "array", "items": { "type": "string" } },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": { "x": { "type": "number" }, "y": { "type": "number" } }
    },
    "class": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "health", "speed", "radius", "resource", "basicAttack"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string" },
        "health": { "type": "number", "exclusiveMinimum": 0 },
        "speed": { "type": "number", "minimum": 0 },
        "radius": { "type": "number", "exclusiveMinimum": 0 },
        "resource": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "max"],
          "properties": {
            "type": { "type": "string" },
            "max": { "type": "number", "exclusiveMinimum": 0 },
            "initial": { "type": "number", "minimum": 0 },
            "regenPerSecond": { "type": "number" }
          }
        },
        "basicAttack": { "$ref": "#/$defs/id" },
        "abilities": { "$ref": "#/$defs/idList" }
      }
    },
    "ability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "targeting"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string" },
        "tags": { "$ref": "#/$defs/stringList" },
        "cost": {
          "type": "object",
          "additionalProperties": false,
          "required": ["resource", "amount"],
          "properties": { "resource": { "type": "string" }, "amount": { "type": "number", "minimum": 0 } }
        },
        "cooldown": { "$ref": "#/$defs/seconds" },
        "castTime": { "$ref": "#/$defs/seconds" },
        "castWhileMoving": { "type": "boolean" },
        "targeting": { "$ref": "#/$defs/targeting" },
        "effects": { "type": "array", "items": { "$ref": "#/$defs/effect" } }
      }
    },
    "targeting": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["type"],
          "properties": { "type": { "const": "self" } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "range"],
          "properties": { "type": { "const": "unit" }, "range": { "type": "number", "exclusiveMinimum": 0 }, "faction": { "$ref": "#/$defs/faction" } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "range", "angle"],
          "properties": { "type": { "const": "melee_arc" }, "range": { "type": "number", "exclusiveMinimum": 0 }, "angle": { "type": "number", "exclusiveMinimum": 0, "maximum": 360 } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "length", "width"],
          "properties": { "type": { "const": "line" }, "length": { "type": "number", "exclusiveMinimum": 0 }, "width": { "type": "number", "exclusiveMinimum": 0 } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "range", "radius"],
          "properties": { "type": { "const": "circle_at_point" }, "range": { "type": "number", "exclusiveMinimum": 0 }, "radius": { "type": "number", "exclusiveMinimum": 0 } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "radius"],
          "properties": { "type": { "const": "circle_self" }, "radius": { "type": "number", "exclusiveMinimum": 0 } } }
      ]
    },
    "effect": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["type", "base"],
          "properties": { "type": { "const": "damage" }, "base": { "type": "number", "minimum": 0 }, "school": { "$ref": "#/$defs/school" } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "base"],
          "properties": { "type": { "const": "heal" }, "base": { "type": "number", "minimum": 0 } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "amount", "duration"],
          "properties": { "type": { "const": "shield" }, "amount": { "type": "number", "exclusiveMinimum": 0 }, "duration": { "$ref": "#/$defs/seconds" } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "status"],
          "properties": { "type": { "const": "apply_status" }, "status": { "$ref": "#/$defs/id" }, "duration": { "$ref": "#/$defs/seconds" } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "tag"],
          "properties": { "type": { "const": "remove_status" }, "tag": { "type": "string" }, "count": { "type": "integer", "minimum": 1 } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "kind", "distance"],
          "properties": {
            "type": { "const": "displacement" },
            "kind": { "enum": ["dash", "knockback"] },
            "distance": { "type": "number", "exclusiveMinimum": 0 },
            "direction": { "enum": ["aim", "away_from_source", "toward_target", "backward"] }
          } },
        { "type": "object", "additionalProperties": false, "required": ["type"],
          "properties": { "type": { "const": "interrupt" } } },
        { "type": "object", "additionalProperties": false, "required": ["type"],
          "properties": { "type": { "const": "threat" }, "amount": { "type": "number", "minimum": 0 }, "tauntDuration": { "$ref": "#/$defs/seconds" } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "resource", "amount"],
          "properties": { "type": { "const": "resource" }, "resource": { "type": "string" }, "amount": { "type": "number" } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "area"],
          "properties": { "type": { "const": "spawn_area" }, "area": { "$ref": "#/$defs/id" } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "monster"],
          "properties": { "type": { "const": "summon" }, "monster": { "$ref": "#/$defs/id" }, "count": { "type": "integer", "minimum": 1 }, "radius": { "type": "number", "minimum": 0 } } }
      ]
    },
    "effects": { "type": "array", "items": { "$ref": "#/$defs/effect" } },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "defaultDuration"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string" },
        "tags": { "$ref": "#/$defs/stringList" },
        "defaultDuration": { "type": "number", "exclusiveMinimum": 0 },
        "stacking": { "enum": ["refresh", "stack"] },
        "maxStacks": { "type": "integer", "minimum": 1 },
        "periodic": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["interval", "effects"],
            "properties": { "interval": { "type": "number", "exclusiveMinimum": 0 }, "effects": { "$ref": "#/$defs/effects" } }
          }
        },
        "frontal": {
          "type": "object",
          "additionalProperties": false,
          "required": ["arcDegrees", "damageTakenMultiplier"],
          "properties": {
            "arcDegrees": { "type": "number", "exclusiveMinimum": 0, "maximum": 360 },
            "damageTakenMultiplier": { "type": "number", "minimum": 0 }
          }
        },
        "modifiers": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "speedMultiplier": { "type": "number", "minimum": 0 },
            "damageTakenMultiplier": { "type": "number", "minimum": 0 },
            "damageDealtMultiplier": { "type": "number", "minimum": 0 }
          }
        },
        "flags": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "stunned": { "type": "boolean" }, "rooted": { "type": "boolean" }, "silenced": { "type": "boolean" } }
        }
      }
    },
    "area": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "radius", "duration"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "radius": { "type": "number", "exclusiveMinimum": 0 },
        "duration": { "type": "number", "exclusiveMinimum": 0 },
        "interval": { "$ref": "#/$defs/seconds" },
        "mode": { "enum": ["periodic", "on_enter_once"] },
        "affects": { "$ref": "#/$defs/faction" },
        "effects": { "$ref": "#/$defs/effects" }
      }
    },
    "monster": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "health", "speed", "radius", "ai"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string" },
        "health": { "type": "number", "exclusiveMinimum": 0 },
        "speed": { "type": "number", "minimum": 0 },
        "radius": { "type": "number", "exclusiveMinimum": 0 },
        "rank": { "enum": ["normal", "elite", "boss"] },
        "tags": { "$ref": "#/$defs/stringList" },
        "resistances": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/school" },
          "additionalProperties": { "type": "number" }
        },
        "abilities": { "$ref": "#/$defs/idList" },
        "ai": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id"],
          "properties": {
            "id": { "type": "string" },
            "parameters": { "type": "object", "additionalProperties": { "type": "number" } }
          }
        }
      }
    },
    "arena": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "lines"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "lines": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "description": "'#' parede, '.' chão; retangular" },
        "scale": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "encounter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "arena", "players", "enemies"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string" },
        "arena": { "$ref": "#/$defs/id" },
        "players": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["class", "position"],
            "properties": { "class": { "$ref": "#/$defs/id" }, "position": { "$ref": "#/$defs/position" } }
          }
        },
        "enemies": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["monster", "position"],
            "properties": { "monster": { "$ref": "#/$defs/id" }, "position": { "$ref": "#/$defs/position" } }
          }
        },
        "victory": { "enum": ["all_enemies_dead"] },
        "defeat": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "condition": { "enum": ["all_players_dead"] },
            "timeLimit": { "type": "number", "exclusiveMinimum": 0 }
          }
        }
      }
    }
  }
}
