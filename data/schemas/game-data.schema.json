{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "game-data.schema.json",
  "title": "Dados de jogo (data/*.json)",
  "description": "Apenas para autocomplete no editor. A validação oficial é a do Game.Data (C#). Tempos em segundos.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "classes": { "type": "array", "items": { "$ref": "#/$defs/class" } },
    "abilities": { "type": "array", "items": { "$ref": "#/$defs/ability" } },
    "statuses": { "type": "array", "items": { "$ref": "#/$defs/status" } },
    "areas": { "type": "array", "items": { "$ref": "#/$defs/area" } },
    "monsters": { "type": "array", "items": { "$ref": "#/$defs/monster" } },
    "arenas": { "type": "array", "items": { "$ref": "#/$defs/arena" } },
    "encounters": { "type": "array", "items": { "$ref": "#/$defs/encounter" } },
    "rules": {
      "type": "object",
      "description": "Regras globais; uma seção por assunto (control, threat...).",
      "properties": {
        "stats": {
          "type": "object",
          "additionalProperties": false,
          "description": "T-201: estatísticas derivadas (vida por VIT, Mana, crítico, velocidade de ataque, defesa).",
          "properties": {
            "healthPerVit": { "type": "number", "minimum": 0 },
            "manaBase": { "type": "number", "minimum": 0 },
            "manaPerInt": { "type": "number", "minimum": 0 },
            "manaRegenPerInt": { "type": "number", "minimum": 0 },
            "critBase": { "type": "number", "minimum": 0, "maximum": 1 },
            "critPerAgi": { "type": "number", "minimum": 0 },
            "critMax": { "type": "number", "minimum": 0, "maximum": 1 },
            "critMultiplier": { "type": "number", "minimum": 1 },
            "attackSpeedPerAgi": { "type": "number", "minimum": 0 },
            "attackSpeedMax": { "type": "number", "minimum": 0 },
            "defenseBase": { "type": "number", "exclusiveMinimum": 0 },
            "defensePerAttackerLevel": { "type": "number", "minimum": 0 },
            "defenseMax": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "progression": {
          "type": "object",
          "additionalProperties": false,
          "description": "T-203: níveis, XP por monstro, divisão em grupo, pontos e requisito de nível por NH.",
          "properties": {
            "maxLevel": { "type": "integer", "minimum": 1 },
            "xpCurveBase": { "type": "number", "exclusiveMinimum": 0 },
            "xpCurveExponent": { "type": "number", "minimum": 0 },
            "xpPerMonsterLevel": { "type": "number", "minimum": 0 },
            "xpByRank": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "normal": { "type": "number", "minimum": 0 },
                "elite": { "type": "number", "minimum": 0 },
                "boss": { "type": "number", "minimum": 0 }
              }
            },
            "xpBonusPerLevelAbove": { "type": "number", "minimum": 0 },
            "xpMaxBonus": { "type": "number", "minimum": 0 },
            "xpPenaltyPerLevelBelow": { "type": "number", "minimum": 0, "maximum": 1 },
            "xpZeroLevelsBelow": { "type": "integer", "minimum": 1 },
            "groupBonusPerMember": { "type": "number", "minimum": 0 },
            "participationWindow": { "$ref": "#/$defs/seconds" },
            "combatTimeout": { "$ref": "#/$defs/seconds" },
            "attributePointsPerLevel": { "type": "integer", "minimum": 0 },
            "skillPointsPerLevel": { "type": "integer", "minimum": 0 },
            "skillRankLevels": { "type": "array", "minItems": 5, "items": { "type": "integer", "minimum": 1 } },
            "signatureRankLevels": { "type": "array", "minItems": 3, "items": { "type": "integer", "minimum": 1 } }
          }
        },
        "control": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "durationByRank": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "normal": { "type": "number", "minimum": 0 },
                "elite": { "type": "number", "minimum": 0 },
                "boss": { "type": "number", "minimum": 0 }
              }
            },
            "diminishing": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "window": { "$ref": "#/$defs/seconds" },
                "steps": { "type": "array", "minItems": 1, "items": { "type": "number", "minimum": 0, "maximum": 1 } }
              }
            }
          }
        }
      }
    },
    "threat": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "damageMultiplier": { "type": "number", "minimum": 0 },
        "healMultiplier": { "type": "number", "minimum": 0 },
        "overtakeRatio": { "type": "number", "minimum": 1 },
        "groupAggroThreat": { "type": "number", "minimum": 0 },
        "proximityThreat": { "type": "number", "minimum": 0 }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$",
      "description": "snake_case com namespace por ponto, ex.: monster.grey_wolf"
    },
    "seconds": { "type": "number", "minimum": 0 },
    "school": { "enum": ["physical", "arcane", "fire", "frost", "holy", "nature"] },
    "faction": { "enum": ["enemy", "ally", "any"] },
    "idList": { "type": "array", "items": { "$ref": "#/$defs/id" } },
    "stringList": { "type": "array", "items": { "type": "string" } },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": { "x": { "type": "number" }, "y": { "type": "number" } }
    },
    "class": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "speed", "radius", "resource", "basicAttack"],
      "description": "Informe health (vida fixa) ou attributes + baseHealth (T-201: vida e Mana pelos atributos).",
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string" },
        "health": { "type": "number", "exclusiveMinimum": 0 },
        "attributes": {
          "type": "object",
          "additionalProperties": false,
          "description": "Perfil inicial (nível 1): FOR, DES, AGI, INT, VIT.",
          "properties": {
            "str": { "type": "integer", "minimum": 0 },
            "dex": { "type": "integer", "minimum": 0 },
            "agi": { "type": "integer", "minimum": 0 },
            "int": { "type": "integer", "minimum": 0 },
            "vit": { "type": "integer", "minimum": 0 }
          }
        },
        "baseHealth": { "type": "number", "exclusiveMinimum": 0 },
        "healthGrowth": { "type": "number", "minimum": 0 },
        "startingWeapon": {
          "type": "object",
          "additionalProperties": false,
          "description": "Arma inicial até os itens (T-204): dano de arma e INT extra (cajado).",
          "properties": { "damage": { "type": "number", "minimum": 0 }, "int": { "type": "integer", "minimum": 0 } }
        },
        "speed": { "type": "number", "minimum": 0 },
        "radius": { "type": "number", "exclusiveMinimum": 0 },
        "resource": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "max"],
          "properties": {
            "type": { "type": "string" },
            "max": { "type": "number", "exclusiveMinimum": 0 },
            "initial": { "type": "number", "minimum": 0 },
            "regenPerSecond": { "type": "number" },
            "passiveOnlyOutOfCombat": { "type": "boolean" },
            "combatTimeout": { "$ref": "#/$defs/seconds" }
          }
        },
        "basicAttack": { "$ref": "#/$defs/id" },
        "abilities": { "$ref": "#/$defs/idList" },
        "consumables": { "$ref": "#/$defs/idList" },
        "resourceRules": { "type": "array", "items": { "$ref": "#/$defs/resourceRule" } }
      }
    },
    "resourceRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "trigger"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "trigger": { "enum": ["damage_taken", "damage_dealt", "heal_done", "shield_applied", "status_removed", "interrupt_done", "ability_executed"] },
        "amount": { "type": "number" },
        "ratio": { "type": "number" },
        "minValue": { "type": "number", "minimum": 0 },
        "targetTag": { "type": "string" },
        "abilityTag": { "type": "string" },
        "minDistance": { "type": "number", "minimum": 0 },
        "maxDistance": { "type": "number", "minimum": 0 },
        "targetHasStatusTag": { "type": "string" },
        "sourceHasStatusTag": { "type": "string" },
        "minEffectiveHealPercent": { "type": "number", "minimum": 0, "maximum": 100 },
        "removedStatusTag": { "type": "string" },
        "internalCooldown": { "$ref": "#/$defs/seconds" }
      }
    },
    "abilityHits": {
      "type": "object",
      "additionalProperties": false,
      "description": "T-060: acertos por uso e intervalo entre eles.",
      "properties": { "count": { "type": "integer", "minimum": 1, "maximum": 5 }, "interval": { "$ref": "#/$defs/seconds" } }
    },
    "abilityRank": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rank"],
      "description": "T-060: nível de habilidade (NH2 em diante). Campos ausentes herdam do nível anterior.",
      "properties": {
        "rank": { "type": "integer", "minimum": 2, "maximum": 5 },
        "cost": {
          "type": "object",
          "additionalProperties": false,
          "required": ["resource", "amount"],
          "properties": { "resource": { "type": "string" }, "amount": { "type": "number", "minimum": 0 } }
        },
        "cooldown": { "$ref": "#/$defs/seconds" },
        "castTime": { "$ref": "#/$defs/seconds" },
        "targeting": { "$ref": "#/$defs/targeting" },
        "telegraph": { "$ref": "#/$defs/telegraph" },
        "effects": { "type": "array", "items": { "$ref": "#/$defs/effect" } },
    "scaling": {
      "type": "object",
      "additionalProperties": false,
      "description": "T-201: valor = base + soma de coeficiente × estatística da fonte (weapon = dano da arma).",
      "properties": {
        "weapon": { "type": "number", "minimum": 0 },
        "str": { "type": "number", "minimum": 0 },
        "dex": { "type": "number", "minimum": 0 },
        "int": { "type": "number", "minimum": 0 },
        "vit": { "type": "number", "minimum": 0 }
      }
    },
        "hits": { "$ref": "#/$defs/abilityHits" },
        "cooldownCharges": { "type": "integer", "minimum": 1 }
      }
    },
    "ability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "targeting"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string" },
        "tags": { "$ref": "#/$defs/stringList" },
        "cost": {
          "type": "object",
          "additionalProperties": false,
          "required": ["resource", "amount"],
          "properties": { "resource": { "type": "string" }, "amount": { "type": "number", "minimum": 0 } }
        },
        "cooldown": { "$ref": "#/$defs/seconds" },
        "castTime": { "$ref": "#/$defs/seconds" },
        "castWhileMoving": { "type": "boolean" },
        "charges": { "type": "integer", "minimum": 1, "description": "Usos por encontro; ausente = ilimitado." },
        "signature": { "type": "boolean", "description": "T-060: assinatura (até 3 níveis em vez de 5)." },
        "hits": { "$ref": "#/$defs/abilityHits" },
        "cooldownCharges": { "type": "integer", "minimum": 1, "description": "T-060: usos guardados que recarregam um a um." },
        "ranks": { "type": "array", "maxItems": 4, "items": { "$ref": "#/$defs/abilityRank" } },
        "targeting": { "$ref": "#/$defs/targeting" },
        "telegraph": { "$ref": "#/$defs/telegraph" },
        "effects": { "type": "array", "items": { "$ref": "#/$defs/effect" } }
      }
    },
    "telegraph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shape", "delay"],
      "description": "circle: radius; cone: length + angle (graus, abertura total); line: length + width. charge só em line.",
      "properties": {
        "shape": { "enum": ["circle", "cone", "line"] },
        "delay": { "type": "number", "exclusiveMinimum": 0 },
        "radius": { "type": "number", "exclusiveMinimum": 0 },
        "length": { "type": "number", "exclusiveMinimum": 0 },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "angle": { "type": "number", "exclusiveMinimum": 0, "maximum": 360 },
        "anchor": { "enum": ["source", "aim"] },
        "affects": { "$ref": "#/$defs/faction" },
        "charge": { "type": "boolean" }
      }
    },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "healthPercent"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "healthPercent": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 },
        "onEnter": { "$ref": "#/$defs/effects" },
        "abilities": { "$ref": "#/$defs/idList" },
        "noSummons": { "type": "boolean" }
      }
    },
    "targeting": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["type"],
          "properties": { "type": { "const": "self" } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "range"],
          "properties": { "type": { "const": "unit" }, "range": { "type": "number", "exclusiveMinimum": 0 }, "faction": { "$ref": "#/$defs/faction" } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "range", "angle"],
          "properties": { "type": { "const": "melee_arc" }, "range": { "type": "number", "exclusiveMinimum": 0 }, "angle": { "type": "number", "exclusiveMinimum": 0, "maximum": 360 } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "length", "width"],
          "properties": { "type": { "const": "line" }, "length": { "type": "number", "exclusiveMinimum": 0 }, "width": { "type": "number", "exclusiveMinimum": 0 } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "range", "radius"],
          "properties": { "type": { "const": "circle_at_point" }, "range": { "type": "number", "exclusiveMinimum": 0 }, "radius": { "type": "number", "exclusiveMinimum": 0 } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "radius"],
          "properties": { "type": { "const": "circle_self" }, "radius": { "type": "number", "exclusiveMinimum": 0 } } }
      ]
    },
    "effect": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["type", "base"],
          "properties": { "target": { "$ref": "#/$defs/effectTarget" }, "onHit": { "$ref": "#/$defs/onHit" }, "type": { "const": "damage" }, "base": { "type": "number", "minimum": 0 }, "scaling": { "$ref": "#/$defs/scaling" }, "school": { "$ref": "#/$defs/school" },
            "bonusVsTags": { "type": "object", "additionalProperties": { "type": "number", "exclusiveMinimum": -1 }, "description": "{ \"undead\": 0.5 } = +50% contra alvos com a tag; somam." } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "base"],
          "properties": { "target": { "$ref": "#/$defs/effectTarget" }, "onHit": { "$ref": "#/$defs/onHit" }, "type": { "const": "heal" }, "base": { "type": "number", "minimum": 0 }, "scaling": { "$ref": "#/$defs/scaling" } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "amount", "duration"],
          "properties": { "target": { "$ref": "#/$defs/effectTarget" }, "onHit": { "$ref": "#/$defs/onHit" }, "type": { "const": "shield" }, "amount": { "type": "number", "exclusiveMinimum": 0 }, "duration": { "$ref": "#/$defs/seconds" }, "scaling": { "$ref": "#/$defs/scaling" },
            "refund": { "type": "object", "additionalProperties": false, "required": ["resource", "fraction"],
              "description": "Ao expirar com sobra, devolve round(sobra × fraction) do recurso a quem criou o escudo.",
              "properties": { "resource": { "type": "string" }, "fraction": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 } } } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "status"],
          "properties": { "target": { "$ref": "#/$defs/effectTarget" }, "onHit": { "$ref": "#/$defs/onHit" }, "type": { "const": "apply_status" }, "status": { "$ref": "#/$defs/id" }, "duration": { "$ref": "#/$defs/seconds" } } },
        { "type": "object", "additionalProperties": false, "required": ["type"],
          "description": "Informe tag ou tags (qualquer uma das tags).",
          "properties": { "target": { "$ref": "#/$defs/effectTarget" }, "onHit": { "$ref": "#/$defs/onHit" }, "type": { "const": "remove_status" }, "tag": { "type": "string" }, "tags": { "$ref": "#/$defs/stringList" }, "count": { "type": "integer", "minimum": 0, "description": "0 = todos os que casarem." } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "kind", "distance"],
          "properties": {
            "target": { "$ref": "#/$defs/effectTarget" },
            "onHit": { "$ref": "#/$defs/onHit" },
            "type": { "const": "displacement" },
            "kind": { "enum": ["dash", "knockback"] },
            "distance": { "type": "number", "exclusiveMinimum": 0 },
            "direction": { "enum": ["aim", "away_from_source", "toward_target", "backward"] }
          } },
        { "type": "object", "additionalProperties": false, "required": ["type"],
          "properties": { "target": { "$ref": "#/$defs/effectTarget" }, "onHit": { "$ref": "#/$defs/onHit" }, "type": { "const": "interrupt" } } },
        { "type": "object", "additionalProperties": false, "required": ["type"],
          "properties": { "target": { "$ref": "#/$defs/effectTarget" }, "onHit": { "$ref": "#/$defs/onHit" }, "type": { "const": "threat" }, "amount": { "type": "number", "minimum": 0 }, "tauntDuration": { "$ref": "#/$defs/seconds" } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "resource", "amount"],
          "properties": { "target": { "$ref": "#/$defs/effectTarget" }, "onHit": { "$ref": "#/$defs/onHit" }, "type": { "const": "resource" }, "resource": { "type": "string" }, "amount": { "type": "number" } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "area"],
          "properties": { "target": { "$ref": "#/$defs/effectTarget" }, "onHit": { "$ref": "#/$defs/onHit" }, "type": { "const": "spawn_area" }, "area": { "$ref": "#/$defs/id" } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "monster"],
          "properties": { "target": { "$ref": "#/$defs/effectTarget" }, "onHit": { "$ref": "#/$defs/onHit" }, "type": { "const": "summon" }, "monster": { "$ref": "#/$defs/id" }, "count": { "type": "integer", "minimum": 1 }, "radius": { "type": "number", "minimum": 0 }, "maxAlive": { "type": "integer", "minimum": 0 } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "jumps", "radius", "effects"],
          "description": "Saltos: do alvo para o mais próximo ainda não atingido, até jumps vezes, aplicando effects com a potência × multiplier.",
          "properties": { "target": { "$ref": "#/$defs/effectTarget" }, "onHit": { "$ref": "#/$defs/onHit" }, "type": { "const": "chain" },
            "jumps": { "type": "integer", "minimum": 1 }, "radius": { "type": "number", "exclusiveMinimum": 0 },
            "multiplier": { "type": "number", "exclusiveMinimum": 0 }, "affects": { "$ref": "#/$defs/faction" }, "effects": { "$ref": "#/$defs/effects" } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "radius", "effects"],
          "description": "Alvos extras em volta do alvo (nearest ou most_injured); count 0 = todos no raio.",
          "properties": { "target": { "$ref": "#/$defs/effectTarget" }, "onHit": { "$ref": "#/$defs/onHit" }, "type": { "const": "extra_targets" },
            "radius": { "type": "number", "exclusiveMinimum": 0 }, "select": { "enum": ["nearest", "most_injured"] },
            "count": { "type": "integer", "minimum": 0 }, "multiplier": { "type": "number", "exclusiveMinimum": 0 },
            "affects": { "$ref": "#/$defs/faction" }, "effects": { "$ref": "#/$defs/effects" } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "radius", "healthFraction"],
          "description": "Levanta aliados caídos perto do alvo com uma fração da vida máxima.",
          "properties": { "target": { "$ref": "#/$defs/effectTarget" }, "onHit": { "$ref": "#/$defs/onHit" }, "type": { "const": "revive" },
            "radius": { "type": "number", "exclusiveMinimum": 0 }, "healthFraction": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
            "count": { "type": "integer", "minimum": 1 } } }
      ]
    },
    "onHit": { "type": "integer", "minimum": 1, "maximum": 5, "description": "Só neste acerto de uma habilidade com vários acertos (1 = o primeiro)." },
    "effects": { "type": "array", "items": { "$ref": "#/$defs/effect" } },
    "effectTarget": { "enum": ["targets", "self"], "description": "targets (padrão) = alvos da habilidade; self = o conjurador." },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "defaultDuration"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string" },
        "tags": { "$ref": "#/$defs/stringList" },
        "defaultDuration": { "type": "number", "exclusiveMinimum": 0 },
        "stacking": { "enum": ["refresh", "stack"] },
        "maxStacks": { "type": "integer", "minimum": 1 },
        "periodic": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["interval", "effects"],
            "properties": { "interval": { "type": "number", "exclusiveMinimum": 0 }, "effects": { "$ref": "#/$defs/effects" } }
          }
        },
        "frontal": {
          "type": "object",
          "additionalProperties": false,
          "required": ["arcDegrees", "damageTakenMultiplier"],
          "properties": {
            "arcDegrees": { "type": "number", "exclusiveMinimum": 0, "maximum": 360 },
            "damageTakenMultiplier": { "type": "number", "minimum": 0 },
            "reflectMeleeFraction": { "type": "number", "minimum": 0, "maximum": 1, "description": "Fração do dano corpo a corpo bloqueado devolvida a quem atacou." }
          }
        },
        "immuneToTags": { "$ref": "#/$defs/stringList" },
        "empower": {
          "type": "object",
          "additionalProperties": false,
          "required": ["abilities", "multiplier"],
          "description": "Fortalece o próximo uso de uma destas habilidades (potência × multiplier) e é consumido.",
          "properties": { "abilities": { "$ref": "#/$defs/stringList" }, "multiplier": { "type": "number", "exclusiveMinimum": 0 } }
        },
        "modifiers": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "speedMultiplier": { "type": "number", "minimum": 0 },
            "damageTakenMultiplier": { "type": "number", "minimum": 0 },
            "damageDealtMultiplier": { "type": "number", "minimum": 0 },
            "controlDurationMultiplier": { "type": "number", "minimum": 0 }
          }
        },
        "flags": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "stunned": { "type": "boolean" }, "rooted": { "type": "boolean" }, "silenced": { "type": "boolean" } }
        }
      }
    },
    "area": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "radius", "duration"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "radius": { "type": "number", "exclusiveMinimum": 0 },
        "duration": { "type": "number", "exclusiveMinimum": 0 },
        "interval": { "$ref": "#/$defs/seconds" },
        "armTime": { "$ref": "#/$defs/seconds", "description": "Segundos até a área ficar armada; antes disso não dispara." },
        "mode": { "enum": ["periodic", "on_enter_once"] },
        "affects": { "$ref": "#/$defs/faction" },
        "effects": { "$ref": "#/$defs/effects" }
      }
    },
    "monster": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "health", "speed", "radius", "ai"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string" },
        "health": { "type": "number", "exclusiveMinimum": 0 },
        "speed": { "type": "number", "minimum": 0 },
        "radius": { "type": "number", "exclusiveMinimum": 0 },
        "rank": { "enum": ["normal", "elite", "boss"] },
        "level": { "type": "integer", "minimum": 1, "description": "T-203: nível do monstro (XP ao matar, nível do atacante na defesa)." },
        "tags": { "$ref": "#/$defs/stringList" },
        "resistances": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/school" },
          "additionalProperties": { "type": "number" }
        },
        "armor": { "type": "number", "minimum": 0, "description": "T-201: defesa contra dano físico." },
        "resistance": { "type": "number", "minimum": 0, "description": "T-201: defesa contra as outras escolas." },
        "abilities": { "$ref": "#/$defs/idList" },
        "ai": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id"],
          "properties": {
            "id": { "type": "string" },
            "parameters": { "type": "object", "additionalProperties": { "type": "number" } }
          }
        },
        "phases": { "type": "array", "items": { "$ref": "#/$defs/phase" } }
      }
    },
    "arena": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "lines"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "lines": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "description": "'#' parede, '.' chão; retangular" },
        "scale": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "encounter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "arena", "players", "enemies"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string" },
        "arena": { "$ref": "#/$defs/id" },
        "players": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["class", "position"],
            "properties": {
              "class": { "$ref": "#/$defs/id" },
              "position": { "$ref": "#/$defs/position" },
              "ranks": {
                "type": "object",
                "additionalProperties": { "type": "integer", "minimum": 1, "maximum": 5 },
                "description": "T-060: NH por habilidade (encontros de teste)."
              }
            }
          }
        },
        "enemies": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["monster", "position"],
            "properties": { "monster": { "$ref": "#/$defs/id" }, "position": { "$ref": "#/$defs/position" } }
          }
        },
        "victory": { "enum": ["all_enemies_dead"] },
        "defeat": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "condition": { "enum": ["all_players_dead"] },
            "timeLimit": { "type": "number", "exclusiveMinimum": 0 }
          }
        }
      }
    }
  }
}
