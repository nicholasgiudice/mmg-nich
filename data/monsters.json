{
  "$schema": "./schemas/game-data.schema.json",
  "monsters": [
    {
      "id": "monster.field_rat",
      "name": "Rato de Campo",
      "health": 105,
      "speed": 5.0,
      "radius": 0.3,
      "tags": ["beast", "vermin"],
      "abilities": ["field_rat.bite"],
      "ai": { "id": "ai.swarm", "parameters": { "aggroRange": 14, "ringRadius": 1.3, "retargetChance": 0.25 } }
    },
    {
      "id": "monster.grey_wolf",
      "name": "Lobo Cinzento",
      "health": 220,
      "speed": 5.0,
      "radius": 0.4,
      "tags": ["beast"],
      "abilities": ["grey_wolf.bite", "grey_wolf.pack_fury"],
      "ai": { "id": "ai.pack", "parameters": { "aggroRange": 14, "focusSeconds": 4, "rallyWindowSeconds": 2 } }
    },
    {
      "id": "monster.road_bandit",
      "name": "Salteador da Estrada",
      "health": 80,
      "speed": 4.2,
      "radius": 0.4,
      "tags": ["humanoid"],
      "abilities": ["road_bandit.shot"],
      "ai": { "id": "ai.ranged_kiter", "parameters": { "aggroRange": 14, "preferredDistance": 7, "retreatDistance": 4 } }
    },
    {
      "id": "monster.skeleton_guard",
      "name": "Guarda Esquelético",
      "health": 400,
      "speed": 3.2,
      "radius": 0.5,
      "tags": ["undead"],
      "abilities": ["skeleton_guard.slash", "skeleton_guard.raise_shield", "skeleton_guard.crushing_blow"],
      "ai": { "id": "ai.guardian", "parameters": { "aggroRange": 14, "guardSeconds": 3, "recoverSeconds": 1.5, "faceIntervalSeconds": 1 } }
    },
    {
      "id": "monster.spider_small",
      "name": "Aranha Menor",
      "health": 70,
      "speed": 4.0,
      "radius": 0.35,
      "tags": ["beast", "spider"],
      "abilities": ["spider_small.bite"],
      "ai": { "id": "ai.melee_chaser", "parameters": { "aggroRange": 30 } }
    },
    {
      "id": "monster.spider_big",
      "name": "Aranha Grande",
      "health": 400,
      "speed": 3.4,
      "radius": 0.6,
      "rank": "elite",
      "tags": ["beast", "spider"],
      "abilities": ["spider_big.bite"],
      "ai": { "id": "ai.melee_chaser", "parameters": { "aggroRange": 30 } }
    },
    {
      "id": "monster.forest_matriarch",
      "name": "Matriarca da Floresta",
      "rank": "boss",
      "health": 6000,
      "speed": 3.4,
      "radius": 0.9,
      "tags": ["beast", "spider", "boss"],
      "abilities": [
        "matriarch.charge",
        "matriarch.bite",
        "matriarch.rending_bite",
        "matriarch.venom_pool",
        "matriarch.venom_pool_fast",
        "matriarch.web_field",
        "matriarch.summon_lesser"
      ],
      "ai": { "id": "ai.boss", "parameters": { "aggroRange": 40 } },
      "phases": [
        {
          "id": "phase.hunt",
          "healthPercent": 100,
          "abilities": ["matriarch.charge", "matriarch.bite", "matriarch.venom_pool", "matriarch.summon_lesser"]
        },
        {
          "id": "phase.suffocating_web",
          "healthPercent": 66,
          "onEnter": [{ "type": "summon", "monster": "monster.spider_big", "count": 1, "radius": 2.5, "maxAlive": 1 }],
          "abilities": [
            "matriarch.charge",
            "matriarch.bite",
            "matriarch.venom_pool_fast",
            "matriarch.web_field",
            "matriarch.summon_lesser"
          ]
        },
        {
          "id": "phase.frenzy",
          "healthPercent": 33,
          "noSummons": true,
          "onEnter": [{ "type": "apply_status", "status": "status.frenzy" }],
          "abilities": ["matriarch.charge", "matriarch.rending_bite", "matriarch.venom_pool_fast"]
        }
      ]
    }
  ]
}
